				gpio-controller;
				interrupts = <0x00 0x82 0x04>;
				compatible = "sprd,sharkl3-gpio-plus";
				#interrupt-cells = <0x02>;
				reg = <0x402c0000 0x1000>;
				phandle = <0x13>;
