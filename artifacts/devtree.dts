			clock-names = "apb_pclk";
			clocks = <0x0a>;
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x00 0x12003000 0x00 0x1000>;

			port@0 {

				etf_big_out: endpoint {
					remote-endpoint = <0x89>;
					phandle = <0x8d>;
				};
