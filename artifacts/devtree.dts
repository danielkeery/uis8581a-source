			sprd_hwdvfs: hwdvfs@40300000 {
				sprd,anlg-phy-g4-ctrl = <0x20>;
				interrupts = <0x00 0x79 0x04>;
				compatible = "sprd,sharkl3-hwdvfs";
				sprd,syscon-enable = <0x02>;
				reg = <0x40300000 0x1000>;
				phandle = <0x118>;

				hwdvfs_cluster0: cluster@0 {
					dcdc-ctrl = <0x5b>;
					reg = <0x00>;
					phandle = <0x119>;
				};

				dcdc_ctrl1: dcdc-controller@1 {
					volt-pause-us = <0x14>;
					volt-stable-us = <0x19>;
					volt-max-step-microvolt = <0x124f84>;
					volt-hold-us = <0x19>;
					volt-timeout-us = <0x320>;
					reg = <0x01 0x02>;
					phandle = <0x5b>;
					volt-via-i2c;
				};

				hwdvfs_cluster1: cluster@1 {
					dcdc-ctrl = <0x5c>;
					reg = <0x01>;
					phandle = <0x11a>;
				};

				dcdc_ctrl0: dcdc-controller@0 {
					volt-pause-us = <0x05>;
					volt-stable-us = <0x05>;
					volt-max-step-microvolt = <0x61a8>;
					volt-hold-us = <0x32>;
					volt-timeout-us = <0x320>;
					reg = <0x00 0x00>;
					phandle = <0x5c>;
					volt-via-adi;
				};

				hwdvfs_dsu: dsu@0 {
					dcdc-ctrl = <0x5c>;
					reg = <0x00>;
					phandle = <0x11b>;
				};
			};

			cpu_thm: cpu-thm@40390000 {
				nvmem-cells = <0x58 0x59 0x5a>;
				sprd,algor_ver = <0x01>;
				clock-names = "enable";
				clocks = <0x05 0x20>;
				#thermal-sensor-cells = <0x01>;
				compatible = "sprd,sharkl3-thermal";
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal", "thm_delta_cal";
				reg = <0x40390000 0x10000>;
				phandle = <0xdc>;
