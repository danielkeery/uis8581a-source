	sprd_marlin3: sprd-marlin3 {
		pwrseq_disable;
		wcn-power-gpios = <0x13 0x52 0x00>;
		wcn-power-gpios-1v2 = <0x13 0x29 0x00>;
		sprd,wcn-usb-available;
		sprd,btwf-file-name = "/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/wcnmodem";
		clock-names = "clk_32k", "source", "enable";
		avdd12-supply = <0xca>;
		common_chip_en;
		clocks = <0x0c 0x0b 0x45 0x05 0x21>;
		avdd33-supply = <0xcb>;
		sprd,gnss-file-name = "/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/gnssmodem";
		adma-tx;
		reset-gpios = <0x13 0x8c 0x00>;
		adma-rx;
		compatible = "sprd,marlin3";
		m2-to-ap-coexist-gpios = <0x13 0x77 0x00>;
		post-power-on-delay-ms = <0x14>;
		permit-ap-send-gpios = <0x13 0x35 0x00>;
		dvdd12-supply = <0xca>;
		enable-gpios = <0x13 0x1b 0x00>;
		phandle = <0x171>;
		xtal-26m-clk-type = "TCXO";
		m2-wakeup-ap-gpios = <0x13 0x4d 0x00>;
		m2-to-ap-irq-gpios = <0x13 0x79 0x00>;
		sprd,keep-power-on;
		sdhci-name = <0xed>;
		dcxo18-supply = <0xec>;
		sprd,wait-ge2-disabled;
