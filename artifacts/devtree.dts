	usb3: usb3@40d00000 {
		sprd-net-power-gpios = <0x13 0x1c 0x00>;
		#address-cells = <0x02>;
		sprd,cable-detection-method = "none";
		#size-cells = <0x02>;
		hub-rstn-gpios = <0x13 0x19 0x00>;
		hub-vbus-gpios = <0x13 0x14 0x00>;
		compatible = "sprd,dwc-marlin3e-usb3";
		ranges;
		status = "okay";
		reg = <0x00 0x40d00000 0x00 0x100000>;
		usb-phy = <0xef 0xef>;
		phandle = <0x172>;
		hub-en-gpios = <0x13 0x4c 0x00>;
		sprd,por-after-power-collapse;

		dwc3@40d00000 {
			snps,ep_out_aligned_size_quirk;
			phy_type = "utmi_wide";
			snps,usb3-u1u2-disable;
			snps,dis_u2_susphy_quirk;
			snps,disconnect_event_quirk;
			snps,usb3_slow_suspend;
			compatible = "synopsys,marlin3e-dwc3";
			snps,dis_u3_susphy_quirk;
			reg = <0x00 0x40d00000 0x00 0xcc00>;
			usb-phy = <0xef 0xef>;
			snps,overlap_check_quirk;
		};
	};

	thm_zone: thermal-zones {
		phandle = <0x165>;

		gpu_thmzone: gpu-thmzone {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0xe0 0x00>;
			phandle = <0x169>;
		};

		cpu_thmzone: cpu-thmzone {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0xdc 0x00>;
			sustainable-power = <0xbb8>;
			phandle = <0x166>;

			trips {

				cpu_crit: bia_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x168>;
				};

				cpu_threshold: trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x167>;
				};

				cpu_target: trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xdd>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0xdd>;
					cooling-device = <0xde 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};

				map1 {
					trip = <0xdd>;
					cooling-device = <0xdf 0xffffffff 0xffffffff>;
					contribution = <0x2a2>;
				};
			};
		};
	};

	gic: interrupt-controller@14000000 {
		#address-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupts = <0x01 0x09 0x04>;
		#size-cells = <0x02>;
		redistributor-stride = <0x00 0x20000>;
		compatible = "arm,gic-v3";
		ranges;
		#interrupt-cells = <0x03>;
		reg = <0x00 0x14000000 0x00 0x20000 0x00 0x14040000 0x00 0x100000>;
		phandle = <0x01>;
		interrupt-controller;

		v2m_0: v2m@0 {
			msi-controller;
			compatible = "arm,gic-v2m-frame";
			reg = <0x00 0x00 0x00 0x1000>;
			phandle = <0x14a>;
		};
	};

	soc: soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;
		phandle = <0xf2>;

		aon {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "simple-bus";
			ranges;

			gpu_thm: gpu-thm@402f0000 {
				nvmem-cells = <0x57>;
				sprd,algor_ver = <0x02>;
				clock-names = "enable";
				clocks = <0x05 0x20>;
				#thermal-sensor-cells = <0x01>;
				compatible = "sprd,sharkl3-thermal";
				nvmem-cell-names = "thm_delta_cal";
				reg = <0x402f0000 0x10000>;
				phandle = <0xe0>;
			};

			i2c7: i2c@40080000 {
				#address-cells = <0x01>;
				clock-names = "enable", "i2c", "source", "clk_hw_i2c";
				interrupts = <0x00 0x22 0x04>;
				#size-cells = <0x00>;
				clock-frequency = <0x61a80>;
				compatible = "sprd,sharkl3-hw-i2c";
				status = "okay";
				reg = <0x40080000 0x1000>;
				phandle = <0x117>;

				fan53555_dcdc: regulator@60 {
					regulator-max-microvolt = <0x1587b8>;
					regulator-always-on;
					regulator-min-microvolt = <0x93378>;
					regulator-name = "fan53555";
					regulator-ramp-delay = <0xfa00>;
					fcs,suspend-voltage-selector = <0x01>;
					compatible = "fcs,fan53555";
					reg = <0x60>;
					phandle = <0xa5>;
				};
			};

			djtag: djtag@40340000 {
				#address-cells = <0x01>;
				clock-names = "enable", "tck";
				clocks = <0x05 0x30 0x05 0x29>;
				#size-cells = <0x00>;
				syscon-names = "soft_rst";
				hwlock-names = "djtag";
				compatible = "sprd,djtag";
				reg = <0x40340000 0x1000>;
				phandle = <0x11d>;
				syscons = <0x02 0x130 0x80>;
				hwlocks = <0x46 0x0a>;

				apcpu-busmonitor@7 {
					sprd,bm-type = <0x01 0x01>;
					sprd,bm-ranges = <0x00 0x00 0x00 0x00>;
					sprd,bm-config = <0x00 0x01 0x01 0x00 0x01 0x01>;
					interrupts = <0x00 0x57 0x04>;
					sprd,bm-name = "ACE", "AP";
					sprd,bm-dap = <0x01 0x02>;
					compatible = "sprd,sharkl3-busmonitor";
					sprd,bm-num = <0x02>;
					sprd,bm-id = <0x00 0x00 0x00 0x00 0x00 0x00>;
					reg = <0x07>;
				};

				aon-busmonitor@3 {
					sprd,bm-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
					sprd,bm-ranges = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
					sprd,bm-config = <0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x01 0x01>;
					interrupts = <0x00 0x5c 0x04>;
					sprd,bm-name = "AP", "WTLCP", "PUBCP", "SP", "DMA", "EAXI", "WCN";
					sprd,bm-dap = <0x00 0x02 0x01 0x03 0x04 0x05 0x09>;
					compatible = "sprd,sharkl3-busmonitor";
					sprd,bm-num = <0x07>;
					sprd,bm-id = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
					reg = <0x03>;
				};
			};

			aon_dma: dma-controller@40100000 {
				clock-names = "enable";
				#dma-channels = <0x09>;
				clocks = <0x05 0x32>;
				compatible = "sprd,sharkl3-dma";
				reg = <0x40100000 0x4000>;
				phandle = <0xa3>;
				#dma-cells = <0x01>;
			};

			watchdog@40310000 {
				clock-names = "enable", "rtc_enable";
				interrupts = <0x00 0x7c 0x04>;
				clocks = <0x05 0x26 0x05 0x42>;
				timeout-sec = <0x1e>;
				compatible = "sprd,sharkl3-wdt";
				reg = <0x40310000 0x1000>;
			};

			aon_sysfrt: timer@40040000 {
				clocks = <0x45>;
				compatible = "sprd,sysfrt-timer";
				reg = <0x40040000 0x10>;
				phandle = <0x115>;
			};

			timer@40050020 {
				interrupts = <0x00 0x1c 0x04>;
				clocks = <0x45>;
				compatible = "sprd,sharkl3-suspend-timer";
				reg = <0x40050020 0x14>;
			};

			eic_latch: gpio@40210080 {
				gpio-controller;
				interrupts = <0x00 0x25 0x04>;
				compatible = "sprd,sharkl3-eic-latch";
				#interrupt-cells = <0x02>;
				reg = <0x40210080 0x20 0x40370080 0x20>;
				phandle = <0x112>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			pwms: pwm@40260000 {
				clock-names = "clk_parent", "clk_pwm0", "clk_pwm0_eb", "clk_pwm1", "clk_pwm1_eb", "clk_pwm2", "clk_pwm2_eb";
				clocks = <0x0a 0x0c 0x0f 0x05 0x04 0x0c 0x10 0x05 0x05 0x0c 0x11 0x05 0x06>;
