		aon_apb_regs: syscon@402e0000 {
			compatible = "syscon";
			reg = <0x00 0x402e0000 0x00 0x10000>;
			phandle = <0x02>;
			#syscon-cells = <0x02>;
		};

		ap-apb {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "simple-bus";
			ranges;

			i2c2: i2c@70700000 {
				#address-cells = <0x01>;
				clock-names = "enable", "i2c", "source";
				interrupts = <0x00 0x0d 0x04>;
				clocks = <0x08 0x09 0x09 0x10 0x0a>;
				#size-cells = <0x00>;
				syscon-names = "i2c_rst";
				clock-frequency = <0x186a0>;
				compatible = "sprd,sharkl3-i2c";
				status = "okay";
				reg = <0x70700000 0x1000>;
				phandle = <0x100>;
				syscons = <0x0b 0x04 0x400>;

				ltr308@53 {
					compatible = "ltr,ltr308als";
					reg = <0x53>;
					gpios = <0x13 0x34 0x00 0x13 0x9c 0x00 0x13 0x37 0x00>;
				};

				lsm6dsm@6a {
					st,drdy-int-pin = <0x02>;
					pwren-gpios = <0x13 0x20 0x00>;
					compatible = "st,lsm6dsm";
					reg = <0x6a>;
					gpios = <0x13 0x7e 0x00>;
				};

				bh1750 {
					compatible = "lsec,bh1750";
					reg = <0x5c>;
					gpios = <0x13 0x34 0x00 0x13 0x9c 0x00>;
				};
			};

			i2c1: i2c@70600000 {
				#address-cells = <0x01>;
				clock-names = "enable", "i2c", "source";
				interrupts = <0x00 0x0c 0x04>;
				clocks = <0x08 0x08 0x09 0x0f 0x0a>;
				#size-cells = <0x00>;
				syscon-names = "i2c_rst";
				clock-frequency = <0x186a0>;
				compatible = "sprd,sharkl3-i2c";
				status = "okay";
				reg = <0x70600000 0x1000>;
				phandle = <0xfe>;
				syscons = <0x0b 0x04 0x200>;

				sensor_sub: sensor-sub@44 {
					backcar-irq-gpios = <0x13 0x1e 0x03>;
					vddcama-supply = <0x0f>;
