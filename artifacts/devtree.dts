						};

						cc_cal: calib@1a {
							reg = <0x1a 0x02>;
							phandle = <0x5e>;
						};

						fgu_calib: calib@6 {
							reg = <0x06 0x02>;
							phandle = <0x63>;
						};

						efuse_blk14: calib@28 {
							reg = <0x28 0x02>;
							phandle = <0xd2>;
						};

						adc_scal: calib@26 {
							reg = <0x26 0x02>;
							phandle = <0x61>;
						};

						adc_bcal: calib@24 {
							reg = <0x24 0x02>;
							phandle = <0x60>;
						};

						efuse_blk0: calib@0 {
							reg = <0x00 0x02>;
							phandle = <0xd1>;
						};
					};

					poweroff@c20 {
						compatible = "sprd,sc27xx-poweroff", "sprd,sc2721-poweroff";
						reg = <0xc20>;
					};

					sprd_audio_codec_ana: audio-codec@700 {
						digital-codec = <0x64>;
						interrupts = <0x06 0x00>;
						#sound-dai-cells = <0x01>;
						compatible = "sprd,sc2721-audio-codec", "sprd,sc27xx-audio-codec";
						status = "okay";
						reg = <0x700>;
						sprd,syscon-pmu-apb = <0x07>;
						phandle = <0xd7>;
					};

					led-controller@180 {
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						compatible = "sprd,sc27xx-bltc", "sprd,sc2721-bltc";
						reg = <0x180>;

						led@2 {
							label = "blue";
							reg = <0x02>;
						};

						led@0 {
							label = "red";
							reg = <0x00>;
						};

						led@1 {
							label = "green";
							reg = <0x01>;
						};
					};

					pmic_flash: flash@2a8 {
						compatible = "sprd,sc27xx-flash", "sprd,sc2721-flash";
						status = "disabled";
						reg = <0x2a8>;
						phandle = <0x11f>;
					};

					rtc@200 {
						interrupts = <0x01 0x04>;
						interrupt-parent = <0x5d>;
						compatible = "sprd,sc27xx-rtc", "sprd,sc2721-rtc";
						reg = <0x200>;
					};

					pmic_adc: adc@400 {
						vref-supply = <0x5f>;
						nvmem-cells = <0x60 0x61>;
						interrupts = <0x00 0x04>;
						#io-channel-cells = <0x01>;
						interrupt-parent = <0x5d>;
						compatible = "sprd,sc27xx-adc", "sprd,sc2721-adc";
						nvmem-cell-names = "big_scale_calib", "small_scale_calib";
						reg = <0x400>;
						phandle = <0x21>;
						hwlocks = <0x46 0x04>;
					};

					hw_reset@eec {
						compatible = "sprd,sc27xx-7sreset", "sprd,sc2721-7sreset";
						reg = <0xf1c 0xeec>;
					};

					vibrator@eb4 {
						compatible = "sprd,sc27xx-vibrator", "sprd,sc2721-vibrator";
						reg = <0xeb4>;
					};

					pmic_typec: typec@380 {
						nvmem-cells = <0x5e>;
						mode = <0x02>;
						interrupts = <0x0a 0x04>;
						interrupt-parent = <0x5d>;
						compatible = "sprd,sc27xx-typec", "sprd,sc2721-typec";
						status = "okay";
						nvmem-cell-names = "cc_calib";
						reg = <0x380>;
						phandle = <0x1e>;
					};

					pmic_fgu: fgu@a00 {
						nvmem-cells = <0x63>;
						sprd,calib-resistance-spec = <0x4e20>;
						monitored-battery = <0x1b>;
						sprd,calib-resistance-real = <0x4e20>;
						interrupts = <0x03 0x04>;
						io-channels = <0x21 0x00 0x21 0x0e>;
						interrupt-parent = <0x5d>;
						compatible = "sprd,sc27xx-fgu", "sprd,sc2720-fgu", "sprd,sc2721-fgu";
						bat-detect-gpio = <0x62 0x09 0x00>;
						nvmem-cell-names = "fgu_calib";
						reg = <0xa00>;
						phandle = <0x120>;
						io-channel-names = "bat-temp", "charge-vol";
					};

					pmic_eic: gpio-controller@280 {
						gpio-controller;
						interrupts = <0x04 0x04>;
						interrupt-parent = <0x5d>;
						compatible = "sprd,sc27xx-eic", "sprd,sc2721-eic";
						#interrupt-cells = <0x02>;
						reg = <0x280>;
						phandle = <0x62>;
						#gpio-cells = <0x02>;
						interrupt-controller;
					};
				};
			};

