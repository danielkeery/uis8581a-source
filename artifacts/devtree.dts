	autotest: autotest {
		sprd,pinctrl = <0xe3>;
		compatible = "sprd,autotest";
		phandle = <0x170>;
	};

	seth_ch31: seth@13 {
		sprd,blknum = <0x100>;
		sprd,channel = <0x1f>;
		sprd,dst = <0x05>;
		compatible = "sprd,seth";
		phandle = <0x160>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x16d>;

		tos_reserved: tos-mem@94020000 {
			reg = <0x00 0x94020000 0x00 0x1fe0000>;
			phandle = <0xe9>;
		};

		sml_reserved: sml-mem@94000000 {
			reg = <0x00 0x94000000 0x00 0x20000>;
			phandle = <0xea>;
		};

		fb_reserved: framebuffer@fe769000 {
			reg = <0x00 0xfe769000 0x00 0x1817000>;
			phandle = <0xf0>;
		};

		logo_reserved: logobuffer@fd482000 {
			reg = <0x00 0xfd482000 0x00 0x8e7000>;
			phandle = <0x68>;
		};

		pstore_reserved: ramoops@fff80000 {
			record-size = <0x8000>;
			pmsg-size = <0x8000>;
			compatible = "ramoops";
			console-size = <0x8000>;
			reg = <0x00 0xfff80000 0x00 0x40000>;
			phandle = <0x16e>;
		};

		wcn_reserved: wcn-mem@84000000 {
			reg = <0x00 0x84000000 0x00 0x300000>;
			phandle = <0xc9>;
		};

		cp_reserved: cp-modem@89600000 {
			reg = <0x00 0x89600000 0x00 0x5850000>;
			phandle = <0xe6>;
		};

		camera_reserved: camera@fdd69000 {
			reg = <0x00 0xfdd69000 0x00 0xa00000>;
			phandle = <0xf1>;
		};

		fyt_reserved: fyt-mem@8445b000 {
			reg = <0x00 0x8445b000 0x00 0x100000>;
			phandle = <0x16f>;
		};

		gnss_reserved: gnss-mem@84300000 {
			reg = <0x00 0x84300000 0x00 0x15b000>;
			phandle = <0xcf>;
		};

		smem_reserved: sipc-mem@87800000 {
			reg = <0x00 0x87800000 0x00 0x800000>;
			phandle = <0xe8>;
		};
	};

	ext_4m3: ext-4m3 {
		clock-output-names = "ext_4m3";
		#clock-cells = <0x00>;
		clock-frequency = <0x419ce0>;
		compatible = "fixed-clock";
		phandle = <0x142>;
	};

	rco_100m: rco-100m {
		clock-output-names = "rco-100m";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		compatible = "fixed-clock";
		phandle = <0x149>;
	};

