		sprd,ctrl-shutdown-us-delay = <0x0a 0x0a>;
	};

	firmware {

		android {
			compatible = "android,firmware";

			vbmeta {
				parts = "socko,odmko,boot,recovery,dtbo,l_modem,pm_sys,l_ldsp,l_gdsp";
				compatible = "android,vbmeta";
			};
		};
	};

	ext_1k: ext-1k {
		clock-output-names = "ext_1k";
		#clock-cells = <0x00>;
		clock-frequency = <0x400>;
		compatible = "fixed-clock";
		phandle = <0x44>;
	};

	tboard_thermistor: thermal-sensor {
		io-channels = <0x21 0x01>;
		#thermal-sensor-cells = <0x00>;
		temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
		compatible = "generic-adc-thermal";
		phandle = <0x173>;
		io-channel-names = "sensor-channel";
	};

	hwfeature {

		auto {
			efuse = "UIS8581AW";
			efuse_raw = "1";
		};
	};

	chosen {
		linux,initrd-end = <0x00 0x8560a7ca>;
		bootargs = "  console=null,115200n8 loglevel=1 init=/init root=/dev/ram0 rw androidboot.hardware=uis8581a2h10 androidboot.dtbo_idx=0 printk.devkmsg=on androidboot.boot_devices=soc/soc:ap-ahb/20600000.sdio lcd_id=IDc16202ff lcd_name=lcd_icn6202_mipi2lvds lcd_base=fd482000 lcd_size=1280x800 pixel_clock=64000000 logo_bpix=24 androidboot.aidenoise=0 androidboot.ddrsize=4096M androidboot.ddrsize.range=[2048,) androidboot.auto.efuse=UIS8581AW  sysdump_magic=85500000 modem=shutdown ltemode=lcsfb rfboard.id=6 wifionly=1 rfhw.id=1 androidboot.lsecid=24 crystal=3 32k.less=0 androidboot.pmic.chipid=2721 modemboot.method=emmcboot  androidboot.verifiedbootstate=green androidboot.flash.locked=1  androidboot.serialno=75807818757510";
		linux,initrd-start = <0x00 0x85500000>;
		stdout-path = "/soc/ap-apb/serial@70100000";
	};

