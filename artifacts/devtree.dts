				clock-names = "sdio_clk", "sdio_clk_source", "sdio_ahb_enable";
				vqmmc-supply = <0x26>;
				no-mmc;
				bus-width = <0x04>;
				no-sdio;
				interrupts = <0x00 0x39 0x04>;
				clocks = <0x0c 0x1e 0x23 0x02 0x1d 0x04>;
				sprd,sdr50-dly = <0x7f 0xff 0xff 0xff>;
				vmmc-supply = <0x25>;
				voltage-ranges = <0xbb8 0xbb8>;
				sprd,sdio-adma;
				compatible = "sprd,sdhc-r11p1";
				status = "okay";
				reg = <0x20300000 0x1000>;
				sprd,sdhs-dly = <0x7f 0x40 0x3b 0x3b>;
				phandle = <0x110>;
				sd-uhs-sdr104;
				sprd,sdr104-dly = <0x7f 0xd1 0xd1 0xd1>;
				cd-gpios = <0x27 0x09 0x01>;
				sd-uhs-sdr50;
			};

			sdio3: sdio@20600000 {
				mmc-hs400-enhanced-strobe;
				sprd,name = "sdio_emmc";
				sprd,hs200-dly = <0x7f 0xcd 0xcd 0xcd>;
				clock-names = "sdio_clk", "sdio_clk_source", "sdio_ahb_enable";
				mmc-hs200-1_8v;
				bus-width = <0x08>;
				non-removable;
				no-sdio;
				mmc-hs400-1_8v;
				interrupts = <0x00 0x3c 0x04>;
				clocks = <0x0c 0x21 0x23 0x02 0x1d 0x07>;
				vmmc-supply = <0x24>;
				voltage-ranges = <0xbb8 0xbb8>;
				cap-mmc-hw-reset;
				sprd,sdio-adma;
				no-sd;
				mmc-ddr-1_8v;
				sprd,hs400es-dly = <0x55 0x7f 0x38 0x38>;
				compatible = "sprd,sdhc-r11p1";
				status = "okay";
				sprd,hs400-dly = <0x55 0xd3 0x35 0x35>;
				reg = <0x20600000 0x1000>;
				sprd,mmchs-dly = <0x38 0x38 0x38 0x38>;
				phandle = <0x10f>;
				sprd,ddr52-dly = <0x32 0x23 0x18 0x18>;
			};

			usb: usb@20200000 {
				phy-names = "usb";
				clock-names = "core_clk";
				phy-type = "usb20_sprd_phy";
				interrupts = <0x00 0x37 0x04>;
				sprd,cable-detection-method = "typec";
				clocks = <0x1d 0x00>;
				extcon = <0x1c 0x1e>;
				compatible = "sprd,sharkl3-musb";
				interrupt-names = "mc";
				reg = <0x20200000 0x2000>;
				usb-phy = <0x1a>;
				phandle = <0x10e>;
				dr-mode = "peripheral";
			};
		};

		ap_intc4_regs: syscon@40540000 {
